<span class="key">D1</span>
<svg class="glyph mark" data-status="you" data-tone="you" width="10" height="10" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
<rect x="3" y="3" width="8" height="8" rx="2" fill="currentColor">
</rect>
</svg>
<span class="hidden">, espera você</span>
</span>
<span class="text">
<span class="title">Descoberta · legacy-erp</span>
<span class="meta">espera você</span>
<button type="button" class="btn btn--you btn--sm" aria-label="Revisar o gate D1: Descoberta · legacy-erp">Revisar o gate</button>
</span>
</li>
<li class="item" data-status="future">
<span class="badge" data-status="future">
<span class="key">D2</span>
<span class="hidden">, depois</span>
</span>
<span class="text">
<span class="title">Planejamento → Execução</span>
<span class="meta">depois</span>
</span>
</li>
<li class="item" data-status="future">
<span class="badge" data-status="future">
<span class="key">D3</span>
<span class="hidden">, depois</span>
</span>
<span class="text">
<span class="title">Execução → Operação</span>
<span class="meta">depois</span>
</span>
</li>
</ol>
</aside>
</div>
</div>
</div>
</main>
<div role="status" aria-live="polite" aria-atomic="true" data-live-region="cockpit">
<span class="hidden">
</span>
</div>
</div>"
`;

