{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kit/schema/agent.schema.json",
  "title": "Frontmatter de agente do kit",
  "description": "Frontmatter de todo *.agent.md do kit (ADR-0018). Validado por scripts/kit-lint.js no build e no CI, sobre o arquivo renderizado ({{brand.*}} resolvido).",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20 },
    "layer": { "type": "string", "enum": ["L1-stream", "L2-phase", "L2-guardian", "L2-sidecar", "L2-domain"] },
    "stream": { "type": "string", "enum": ["foundation", "discovery", "planning", "execution", "upstream", "downstream", "operation", "guardian", "sidecar", "domain"] },
    "phase": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["repo", "workspace", "context"] },
    "receives_from": { "type": "array", "items": { "type": "string" } },
    "delivers_to": { "type": "array", "items": { "type": "string" } },
    "escalates_to": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "exit_contract": { "type": "array", "items": { "type": "string" } },
    "guard_rails": { "type": "array", "items": { "type": "string" } },
    "uses_skills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "token_budget": { "type": "string", "enum": ["low", "medium", "high"] },
    "invoke_on": { "type": "array" },
    "loop_with": { "type": "string" },
    "loop_rounds": { "type": "integer" },
    "model": { "type": "array", "items": { "type": "string" } },
    "argument-hint": { "type": "string" },
    "user-invocable": { "type": "boolean" }
  },
  "additionalProperties": false
}
