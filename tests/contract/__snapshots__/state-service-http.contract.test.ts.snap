    wave_status:
      wave-1:
        item-1.1:
          status: "done"
          repo: "pedidos-api"
          completed_at: "2025-04-10"
          artifacts:
            - "docs/adr/0001-exemplo.md"
          summary: "characterization tests do módulo de pedidos"
          commit: "abc1234"
          known_bugs_pinned:
            - "BUG-SINTETICO-1"
          merge_block: "aguardando revisão"
          requires_approval: true
    epic_status:
      epic-1:
        task-1.1:
          status: "in-progress"
  - id: "catalogo-hotfix"
    name: "catalogo-hotfix"
    status: "planned"
    type: "hotfix"
",
  "initiatives/loja-demo/delivery-state.yaml": "initiative_id: loja-demo
phases:
  business:
    status: in-progress
    agent: "@business"
  product:
    status: in-progress
    agent: "@product"
    checklist:
      prd-ok: false
",
}
`;

