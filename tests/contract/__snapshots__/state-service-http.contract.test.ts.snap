{
  "delivery-state.yaml (global)": "phases:
  business:
    artifacts:
      - path: ".github/artifacts/business-brief.md"
    completed_at: "2025-04-11T10:00:00Z"
    status: done
    agent: "@business"
    human_checklist:
      kpi-defined: true
  product:
    status: pending
",
  "initiatives.yaml": "version: 1
active: "loja-demo"
initiatives:
  - id: loja-demo
    name: "Loja Demo"
    status: in-progress
    stream: upstream
    current_phase: "product"
    mode: greenfield
    type: feature
    created_at: "2025-03-01"
  - id: "pedidos-mod"
    name: "Modernização de Pedidos"
    status: "planned"
    stream: "foundation"
    current_phase: "assessor"
    mode: "brownfield"
    type: "modernization"
    owner: "time-plataforma"
    priority: "P1"
