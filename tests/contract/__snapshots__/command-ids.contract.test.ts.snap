  "chatParticipants": [
    {
      "commands": [
        {
          "description": "Estado atual das iniciativas e fases",
          "name": "status",
        },
        {
          "description": "Criar uma nova iniciativa de delivery",
          "name": "nova",
        },
        {
          "description": "Continuar a fase ativa da iniciativa",
          "name": "continuar",
        },
      ],
      "description": "Mostra onde a iniciativa está e o próximo passo, e encaminha para o agente helyx. Não aciona agentes nem grava arquivos.",
      "fullName": "Guia da Helyx",
      "id": "helyx.concierge",
      "isSticky": true,
      "name": "guia",
    },
  ],
  "configuration": {
    "helyx.approvalFriction.riskFields": {
      "default": [
        "merge_block",
        "known_bugs_pinned",
      ],
      "type": "array",
    },
    "helyx.deliveryHierarchy": {
      "default": "legacy",
      "enum": [
        "legacy",
        "epic-feature-backlog-task",
      ],
      "type": "string",
    },
  },
  "icons": [
    "helyx-mark",
  ],
  "menus": {
    "view/item/context": [],
    "view/title": [],
  },
  "views": {
    "helyx-container": [
      {
        "id": "helyx.welcome",
        "name": "Começar",
        "when": "!helyx.isWorkspace",
      },
      {
        "id": "helyx.mainPanel",
        "name": "Helyx",
        "type": "webview",
        "visibility": "visible",
        "when": "helyx.isWorkspace",
      },
    ],
  },
  "viewsContainers": {
    "activitybar": [
      {
        "icon": "media/helyx-icon.svg",
        "id": "helyx-container",
        "title": "Helyx",
      },
    ],
  },
  "viewsWelcome": [
    {
      "contents": "A Helyx trabalha com uma pasta por vez.
Abra uma pasta para começar, ou crie um projeto novo: a Helyx pergunta onde ele fica.
[Abrir uma pasta](command:workbench.action.files.openFolder)
[Criar um projeto novo](command:helyx.initializeDeliveryKit)",
      "view": "helyx.welcome",
      "when": "workspaceFolderCount == 0",
    },
    {
      "contents": "Esta pasta ainda não é um workspace da Helyx.
A Helyx instala agentes e instruções nela, e só depois de você conferir o que será escrito.
[Começar com a Helyx](command:helyx.initializeDeliveryKit)",
      "view": "helyx.welcome",
      "when": "workspaceFolderCount > 0 && !helyx.isWorkspace",
    },
    {
      "contents": "Esta janela tem mais de uma pasta. A v1 da Helyx trabalha com uma pasta por janela e usa a primeira.",
      "view": "helyx.welcome",
      "when": "workspaceFolderCount > 1 && !helyx.isWorkspace",
    },
  ],
}
`;
