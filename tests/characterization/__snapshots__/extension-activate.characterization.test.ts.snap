    "helyx.concierge.advancePhase",
    "helyx.concierge.continuePhase",
    "helyx.concierge.revealArtifact",
    "helyx.concierge.runRawPrompt",
    "helyx.concierge.startWithTemplate",
    "helyx.concierge.toggleGuardRail",
    "helyx.connectedExtensions",
    "helyx.initializeDeliveryKit",
    "helyx.migrateKit",
    "helyx.openCockpitNext",
    "helyx.refreshTreeView",
    "helyx.revealArtifacts",
    "helyx.sendArtifacts",
    "helyx.startStack",
    "helyx.stopStack",
    "helyx.syncRepos",
    "helyx.validateArtifactSection",
    "helyx.validateRemainingItems",
  ],
