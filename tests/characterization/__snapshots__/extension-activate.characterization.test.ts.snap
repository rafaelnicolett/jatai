    ".github/artifacts/",
    ".github/artifacts/.state-service/",
    ".github/artifacts/.state-service/server.json",
    "ai-sdk.config.yaml",
  ],
  "globalStateUpdates": [
    [
      "helyx.stateServicePort",
      "<port>",
    ],
  ],
  "messages": [],
  "network": [],
  "secretsStored": [
    "helyx.stateServiceToken",
  ],
  "statusBar": [
    {
      "alignment": 1,
      "command": "helyx.openCockpitNext",
      "priority": 100,
      "shown": true,
      "text": "$(helyx-mark) Helyx",
      "tooltip": "Helyx — clique para abrir o Cockpit",
    },
  ],
  "subscriptions": 27,
  "uxTimers": [
    800,
  ],
  "webviewPanels": [],
  "webviewViewProviders": [
    {
      "options": {
        "webviewOptions": {
          "retainContextWhenHidden": true,
        },
      },
      "viewType": "helyx.mainPanel",
    },
  ],
}
