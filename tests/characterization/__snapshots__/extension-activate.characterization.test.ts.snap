    "environmentVariableCollection.clear",
  ],
  "executeCommand": [
    [
      "setContext",
      "helyx.isWorkspace",
      true,
    ],
    [
      "setContext",
      "helyx.projectInitialized",
      true,
    ],
  ],
  "fileWatchers": [
    {
      "base": "<ROOT>/.github/artifacts/runs",
      "pattern": "*.jsonl",
    },
    {
      "base": "<ROOT>/.github/artifacts",
      "pattern": "**/*",
    },
  ],
  "filesInWorkspace": [
