exports[`CK1 — eventos de run → append, toasts e notificação nativa (N4 / CK3) > boot não gera toast; eventos NOVOS (timestamp após o cursor) geram append só do delta + toasts + notificação nativa (review e blocked) 1`] = `
{
  "afterEvents": {
    "in": {
      "type": "refresh",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=2",
      "shell/runEvents-append seq=3 (2 eventos)",
      "shell/toast {"id":"2025-02-04T11:00:00Z-agent-done-pedidos-api-arch","kind":"agent-done","text":"@arch-discoverer terminou · pedidos-api — aguarda aprovação","timestamp":"2025-02-04T11:00:00Z"}",
      "shell/toast {"id":"2025-02-04T11:05:00Z-blocked--domain","kind":"blocked","text":"@domain-extractor bloqueado — contexto ambíguo","timestamp":"2025-02-04T11:05:00Z"}",
    ],
    "vscode": [
      {
        "window.showInformationMessage": [
          "Helyx: Arquitetura — aguarda sua aprovação.",
          "Ver no Cockpit",
        ],
      },
      {
        "window.showWarningMessage": [
          "Helyx: @domain-extractor bloqueado — contexto ambíguo — bloqueado, precisa de decisão.",
          "Ver no Cockpit",
        ],
      },
    ],
  },
  "boot": [
    "shell/snapshot seq=0",
    "shell/runEvents-append seq=1 (4 eventos)",
    "shell/toast {"id":"kit-outdated-<Date.now>","kind":"kit-outdated","text":"Uma versão nova do Helyx Kit está disponível — rode 'Helyx: Migrar Estrutura do Kit'.","timestamp":"<agora>"}",
  ],
  "reconnect": {
    "in": {
      "type": "shell/ready",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=4",
      "shell/runEvents-append seq=5 (6 eventos)",
    ],
    "vscode": [],
  },
  "reveals": [
    1,
  ],
}
`;

exports[`CK1 — golden do CockpitSnapshot + handshake (N2/N3) > brownfield em Foundation — sequência de mensagens: open() e depois o handshake shell/ready 1`] = `
{
  "onOpen": [
    "shell/snapshot seq=0",
    "shell/runEvents-append seq=1 (4 eventos)",
    "shell/toast {"id":"kit-outdated-<Date.now>","kind":"kit-outdated","text":"Uma versão nova do Helyx Kit está disponível — rode 'Helyx: Migrar Estrutura do Kit'.","timestamp":"<agora>"}",
  ],
  "onReady": {
    "in": {
      "type": "shell/ready",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=2",
      "shell/runEvents-append seq=3 (4 eventos)",
    ],
    "vscode": [],
  },
  "onRequest": {
    "in": {
      "type": "shell/requestSnapshot",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=4",
      "shell/runEvents-append seq=5 (4 eventos)",
    ],
    "vscode": [],
  },
}
`;

