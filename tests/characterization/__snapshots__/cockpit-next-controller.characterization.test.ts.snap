exports[`CK1 — golden do CockpitSnapshot + handshake (N2/N3) > greenfield com sprint — sequência de mensagens: open() e depois o handshake shell/ready 1`] = `
{
  "onOpen": [
    "shell/snapshot seq=0",
    "shell/runEvents-append seq=1 (3 eventos)",
  ],
  "onReady": {
    "in": {
      "type": "shell/ready",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=2",
      "shell/runEvents-append seq=3 (3 eventos)",
    ],
    "vscode": [],
  },
  "onRequest": {
    "in": {
      "type": "shell/requestSnapshot",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=4",
      "shell/runEvents-append seq=5 (3 eventos)",
    ],
    "vscode": [],
  },
}
`;

