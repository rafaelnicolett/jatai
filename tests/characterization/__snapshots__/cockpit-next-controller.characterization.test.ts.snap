exports[`CK1 — despacho pelo registry de ações (N2) — efeitos observáveis > notifications/markSeen grava globalState e o snapshot seguinte carrega notificationsLastSeenAt 1`] = `
{
  "in": {
    "type": "notifications/markSeen",
  },
  "network": [],
  "posted": [
    "shell/snapshot seq=2",
  ],
  "vscode": [
    {
      "globalState.update": [
        "helyx.notifications.lastSeenAt",
        "<agora>",
      ],
    },
  ],
}
`;

exports[`CK1 — despacho pelo registry de ações (N2) — efeitos observáveis > switchInitiative reescreve \`active:\` in-place (sem aspas) e o próximo snapshot já traz a nova ativa 1`] = `
