{
  "onOpen": [
    "shell/snapshot seq=0",
  ],
  "onReady": {
    "in": {
      "type": "shell/ready",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=1",
    ],
    "vscode": [],
  },
  "onRequest": {
    "in": {
      "type": "shell/requestSnapshot",
    },
    "network": [],
    "posted": [
      "shell/snapshot seq=2",
    ],
    "vscode": [],
  },
}
`;

