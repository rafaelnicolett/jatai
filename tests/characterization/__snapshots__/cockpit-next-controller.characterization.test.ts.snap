  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src vscode-webview://fake-csp-source data:; style-src vscode-webview://fake-csp-source; font-src vscode-webview://fake-csp-source; script-src 'nonce-<nonce>'">
